{
  "permissions": {
    "allow": [
      "Bash(echo *)",
      "Bash(jj log *)",
      "Bash(jj diff *)",
      "Bash(jj status *)",
      "WebFetch(domain:git.autodesk.com)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv run* ruff*)",
      "Bash(uv run* pytest*)",
      "Bash(* --version)",
      "Bash(* --help)",
      "Bash(jj new -m \"CLAUDE: *)",
      "Bash(gh pr *)",
      "mcp__codebase-memory-mcp__*",
      "Bash(jj file show *)",
      "Bash(jj show *)",
      "Bash(jj bookmark list *)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Read|Search",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-code-discovery-gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [[ \"$f\" == *.py ]] && uv run ruff format \"$f\" && uv run ruff check --fix \"$f\"; } 2>/dev/null || true"
          },
          {
            "type": "agent",
            "prompt": "File(s) were just written or edited. Hook input: $ARGUMENTS\nExtract the file path from tool_input.file_path. If the changed file is itself a documentation file (README, CHANGELOG, anything under docs/), do nothing and stop; otherwise, read the changed file and decide whether any of these docs are affected:\n1. CHANGELOG.md — add a concise entry under an Unreleased section if the change is a meaningful feature, fix, or behaviour change (not a config tweak or linting edit).\n2. README.md — update if the change affects public-facing usage, CLI args, configuration keys, or capabilities.\n3. Any other .md files in docs/ that describe what was changed.\nOnly edit files that genuinely need updating. If nothing needs updating, do nothing. If the document changes are substantial, notify the user.",
            "model": "haiku",
            "statusMessage": "Checking if docs need updating..."
          },
          {
            "type": "agent",
            "prompt": "If the current revision description starts with \"CLAUDE BUGFIX: \", look at the mutable ancestor revisions, and rebase the bufix after that change with `rebase -r @ -A ...`. If there are no relevant revisions, change the description to start with \"CLAUDE:\".",
            "model": "haiku",
            "statusMessage": "Refactoring bugfixes..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-model-router-hook@claude-model-router-hook": true,
    "kiln-setup@kiln-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "cbci-jenkinsfile@cbci-marketplace": true
  },
  "extraKnownMarketplaces": {
    "claude-model-router-hook": {
      "source": {
        "source": "github",
        "repo": "tzachbon/claude-model-router-hook"
      }
    },
    "kiln-marketplace": {
      "source": {
        "source": "git",
        "url": "git@git.autodesk.com:iaas/kiln-marketplace.git"
      }
    },
    "cbci-marketplace": {
      "source": {
        "source": "git",
        "url": "git@git.autodesk.com:cloud-ci/ai-rules.git"
      }
    }
  },
  "forceLoginMethod": "console",
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true,
  "CLAUDE_CODE_ATTRIBUTION_HEADER": "false"
}
